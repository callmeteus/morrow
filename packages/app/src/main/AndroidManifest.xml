<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- On-device speech recognition records from the microphone. No network is used. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:localeConfig="@xml/locale_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.GboardLocal">

        <!-- Launcher / setup screen: enable the IME, grant mic permission, run a local STT self-test. -->
        <activity
            android:name=".SetupActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Read-only provider: lets the IME read the voice backend config. -->
        <provider
            android:name=".VoiceConfigProvider"
            android:authorities="dev.gti.gboard.voiceconfig"
            android:exported="true"
            android:grantUriPermissions="false" />

        <!-- Dev-only: dumps the full UI hierarchy incl. the IME window for REA. -->
        <service
            android:name=".UiDumpService"
            android:exported="false"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service" />
        </service>

        <!-- Transparent helper: requests the mic permission for the IME service. -->
        <activity
            android:name=".PermissionActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:theme="@android:style/Theme.NoDisplay" />

        <!-- The keyboard itself (Input Method Service). -->
        <service
            android:name=".GboardIme"
            android:exported="true"
            android:label="@string/ime_name"
            android:permission="android.permission.BIND_INPUT_METHOD">
            <intent-filter>
                <action android:name="android.view.InputMethod" />
            </intent-filter>
            <meta-data
                android:name="android.view.im"
                android:resource="@xml/method" />
        </service>
    </application>
</manifest>
