<merge
    xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Provide audio and haptic feedback by ourselves based on the keyboard settings.
         We just need to ignore the system's audio and haptic feedback settings. -->
    <LinearLayout
        android:id="@+id/suggestions_strip"
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginLeft="@dimen/config_suggestions_strip_horizontal_margin"
        android:layout_marginRight="@dimen/config_suggestions_strip_horizontal_margin"
        android:hapticFeedbackEnabled="false"
        android:soundEffectsEnabled="false" />
    <!-- Provide audio and haptic feedback by ourselves based on the keyboard settings.
         We just need to ignore the system's audio and haptic feedback settings. -->
    <!-- Provide audio and haptic feedback by ourselves based on the keyboard settings.
         We just need to ignore the system's audio and haptic feedback settings. -->
    <LinearLayout
        android:id="@+id/important_notice_strip"
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginLeft="@dimen/config_suggestions_strip_horizontal_margin"
        android:layout_marginRight="@dimen/config_suggestions_strip_horizontal_margin"
        android:hapticFeedbackEnabled="false"
        android:soundEffectsEnabled="false" >
        <TextView
            android:id="@+id/important_notice_title"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="6sp"
            android:textSize="16sp"
            style="?attr/suggestionWordStyle" />
    </LinearLayout>
    <com.android.inputmethod.latin.suggestions.InlineSuggestionsStrip
        android:id="@+id/inline_suggestions_strip"
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginLeft="@dimen/config_suggestions_strip_horizontal_margin"
        android:layout_marginRight="@dimen/config_suggestions_strip_horizontal_margin"
        android:visibility="invisible" />
    <LinearLayout
        android:id="@+id/clipboard_suggestion_strip"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginLeft="@dimen/config_suggestions_strip_horizontal_margin"
        android:layout_marginRight="@dimen/config_suggestions_strip_horizontal_margin"
        android:visibility="invisible" />
    <!-- gti.dev: Gboard-style toolbar on the left instead of the AOSP floating-key icon. -->
    <!-- gti.dev: toolbar spans the width (minus the mic) with the four icons
         evenly distributed, matching the Gboard reference layout. -->
    <LinearLayout
        android:id="@+id/suggestions_strip_toolbar"
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="fill_parent"
        android:layout_alignParentStart="true"
        android:layout_alignParentLeft="true"
        android:layout_toStartOf="@id/suggestions_strip_voice_key"
        android:layout_toLeftOf="@id/suggestions_strip_voice_key"
        android:layout_centerVertical="true">
        <ImageButton
            android:id="@+id/suggestions_strip_more_key"
            android:layout_width="0dip"
            android:layout_weight="1"
            android:layout_height="fill_parent"
            android:src="@drawable/ic_grid"
            android:contentDescription="@string/spoken_description_more_features"
            style="?attr/suggestionWordStyle" />
        <ImageButton
            android:id="@+id/suggestions_strip_settings_key"
            android:layout_width="0dip"
            android:layout_weight="1"
            android:layout_height="fill_parent"
            android:src="@drawable/ic_settings"
            android:contentDescription="@string/spoken_description_settings"
            style="?attr/suggestionWordStyle" />
        <ImageButton
            android:id="@+id/suggestions_strip_translate_key"
            android:layout_width="0dip"
            android:layout_weight="1"
            android:layout_height="fill_parent"
            android:src="@drawable/ic_translate"
            android:contentDescription="@string/spoken_description_translate"
            style="?attr/suggestionWordStyle" />
        <ImageButton
            android:id="@+id/suggestions_strip_clipboard_key"
            android:layout_width="0dip"
            android:layout_weight="1"
            android:layout_height="fill_parent"
            android:src="@drawable/ic_clipboard"
            android:contentDescription="@string/spoken_description_clipboard"
            style="?attr/suggestionWordStyle" />
    </LinearLayout>
    <ImageButton
        android:id="@+id/suggestions_strip_voice_key"
        android:layout_width="@dimen/config_suggestions_strip_edge_key_width"
        android:layout_height="fill_parent"
        android:layout_alignParentEnd="true"
        android:layout_alignParentRight="true"
        android:layout_centerVertical="true"
        android:background="@drawable/mic_circle_bg"
        android:contentDescription="@string/spoken_description_mic"
        style="?attr/suggestionWordStyle" />
</merge>
