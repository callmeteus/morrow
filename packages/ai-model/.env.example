# Shared speech dataset store. OmniVox Lite (Whisper base 74M, ggml) and
# OmniVox Pro train from one store and the same preparation scripts. The tools
# live in the Pacotes/speech-datasets checkout. No secret belongs in these vars.
# Set SPEECH_DATASETS_TOOLS to enable delegation from the shared Python scripts.
# Root of the shared store. The current machine keeps data here.
# SPEECH_DATASETS_DIR=C:/Users/Gio/training-work/data
# Absolute path of the speech-datasets checkout, added to sys.path by callers.
# SPEECH_DATASETS_TOOLS=C:/Users/Gio/Documents/Projetos/Pacotes/speech-datasets
# Working-set cap in GiB, checked before every shard download (default 25).
# SPEECH_DATASETS_MAX_GB=25
