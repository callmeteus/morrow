# Gradle
.gradle/
build/
local.properties

# IDE
.idea/
*.iml
.vscode/

# The on-device model is fetched separately (see packages/ai-model/fetch-model.ps1).
packages/app/src/main/assets/models/*.bin

# Native build intermediates
packages/app/.externalNativeBuild/
packages/app/.cxx/
packages/app/build/

# Release binaries are published to Hugging Face, kept out of git
releases/*/*.bin
# Local settings
.env

# Private local references (e.g. Gboard UI screenshots), never tracked
.private/

# Gradle/JVM crash logs (local only)
packages/app/aosp-base/hs_err_pid*.log
packages/app/aosp-base/replay_pid*.log

# Stillmark
.stillmark/plans/
.stillmark/learnings/design/
